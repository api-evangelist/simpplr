   ],
   "paths": {
    "/contents/site/{site_id}/content/{content_id}/approval": {
     "post": {
      "summary": "Content Approval",
      "description": "Use this API to approve or reject newly created content",
      "operationId": "content-approval",
      "parameters": [
       {
        "name": "site_id",
        "in": "path",
        "description": "The site id to which the content belongs",
        "schema": {
         "type": "string"
        },
        "required": true
       },
       {
        "name": "content_id",
        "in": "path",
        "description": "The id of the content",
        "schema": {
         "type": "string"
        },
        "required": true
       },
       {
        "name": "x-user-email",
        "in": "header",
        "description": "User's email used to login in salesforce",
        "required": true,
        "schema": {
         "type": "string"
        }
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "action"
          ],
          "properties": {
           "action": {
            "type": "string",
            "description": "The action you want to take on the content",
            "default": "publish",
            "enum": [
             "publish",
             "unpublish"
            ]
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      },
      "deprecated": false
     }
    }
   },
