    }
   ],
   "components": {
    "securitySchemes": {
     "sec0": {
      "type": "oauth2",
      "flows": {}
     }
    }
   },
   "security": [
    {
     "sec0": []
    }
   ],
   "paths": {
    "/analytics/views": {
     "get": {
      "summary": "Get Views List",
      "description": "Use this API to get Views List",
      "operationId": "app-adoption-2",
      "parameters": [
       {
        "name": "from",
        "in": "query",
        "description": "Time from which the Views List need to be selected",
        "required": true,
        "schema": {
         "type": "string",
         "default": "2020-12-27"
        }
       },
       {
        "name": "to",
        "in": "query",
        "description": "Time till which the Views List need to be selected",
        "required": true,
        "schema": {
         "type": "string",
         "default": "2022-01-26"
        }
       },
       {
        "name": "group-by",
        "in": "query",
        "description": "Group the Result according to group-by value",
        "schema": {
         "type": "string",
         "enum": [
          "day",
          "week",
          "month"
         ],
         "default": "day"
        }
       },
       {
        "name": "order-by",
        "in": "query",
        "description": "Order by which result need to be selected",
        "required": true,
        "schema": {
         "type": "string",
         "enum": [
          "top",
          "bottom"
         ],
         "default": "top"
        }
       },
       {
        "name": "result-type",
        "in": "query",
        "description": "Type by which result need to be selected",
        "required": true,
        "schema": {
         "type": "string",
         "enum": [
          "department",
          "location"
         ],
         "default": "department"
        }
       },
       {
        "name": "x-user-email",
        "in": "header",
        "description": "User's email to login into Salesforce",
        "required": true,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "filter-by",
        "in": "query",
        "description": "Filter to apply to results",
        "required": true,
        "schema": {
         "type": "string",
         "enum": [
          null,
          "department",
          "location"
         ],
         "default": null
        }
       },
       {
        "name": "filter-value",
        "in": "query",
        "description": "Value by which result has to filter.",
        "schema": {
         "type": "string"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n    \"statusCode\": 200,\n    \"status\": \"success\",\n    \"message\": \"\",\n    \"data\": {\n        \"data\": [\n            {\n                \"value\": 1,\n                \"url\": \"https://ajay-hada-dev-ed--c.visualforce.com/apex/app?u=/people&location=+%40%40++%40%40+US\",\n                \"uniqueViews\": 0,\n                \"label\": \"US\"\n            },\n            {\n                \"value\": 53,\n                \"url\": \"https://ajay-hada-dev-ed--c.visualforce.com/apex/app?u=/people&location=+%40%40++%40%40+India\",\n                \"uniqueViews\": 0,\n                \"label\": \"India\"\n            }\n        ],\n        \"csvUrl\": \"https://ajay-hada-dev-ed--c.visualforce.com/apex/Reports?action=getViewsList&to=2022-01-26&from=2019-12-27&resultType=location&orderBy=bottom\"\n    }\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "statusCode": {
             "type": "integer",
             "example": 200,
             "default": 0
            },
            "status": {
             "type": "string",
             "example": "success"
            },
            "message": {
             "type": "string",
             "example": ""
            },
            "data": {
             "type": "object",
             "properties": {
              "data": {
               "type": "array",
               "items": {
                "type": "object",
                "properties": {
                 "value": {
                  "type": "integer",
                  "example": 1,
                  "default": 0
                 },
                 "url": {
                  "type": "string",
                  "example": "https://ajay-hada-dev-ed--c.visualforce.com/apex/app?u=/people&location=+%40%40++%40%40+US"
                 },
                 "uniqueViews": {
                  "type": "integer",
                  "example": 0,
                  "default": 0
                 },
                 "label": {
                  "type": "string",
                  "example": "US"
                 }
                }
               }
              },
              "csvUrl": {
               "type": "string",
               "example": "https://ajay-hada-dev-ed--c.visualforce.com/apex/Reports?action=getViewsList&to=2022-01-26&from=2019-12-27&resultType=location&orderBy=bottom"
              }
             }
            }
           }
          }
         }
        }
       },
       "401": {
        "description": "401",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n    \"statusCode\": 401,\n    \"status\": \"error\",\n    \"message\": \"SESSION_TIMEOUT\",\n    \"data\": {}\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "statusCode": {
             "type": "integer",
             "example": 401,
             "default": 0
            },
            "status": {
             "type": "string",
             "example": "error"
            },
            "message": {
             "type": "string",
             "example": "SESSION_TIMEOUT"
            },
            "data": {
             "type": "object",
             "properties": {}
            }
           }
          }
         }
        }
       }
      },
      "deprecated": false
     }
    }
   },
